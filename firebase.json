{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/mcp", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/authorize", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/token", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/register", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/revoke", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/.well-known/oauth-authorization-server", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/.well-known/oauth-protected-resource", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/.well-known/oauth-protected-resource/**", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "src", "test", "*.log", "vitest.config.ts", "tsconfig.json"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
