# Copy to functions/.env before deploying.
# Your Google account(s) allowed to connect Claude to Trinity, comma-separated:
ALLOWED_EMAILS=you@gmail.com
# Your time zone (used until the Trinity app saves it):
DEFAULT_TIMEZONE=America/New_York
# Notifications (docs/REMINDERS.md): run `npm run vapid` in functions/ and paste the public key here.
VAPID_PUBLIC_KEY=
